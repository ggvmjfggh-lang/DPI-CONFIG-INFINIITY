    private void addInfo(String name, String value) {
        LinearLayout row = new LinearLayout(this);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(15, 13, 15, 13);
        row.setBackgroundColor(PANEL);

        TextView left = new TextView(this);
        left.setText(name);
        left.setTextColor(WHITE);
        left.setTextSize(14);

        TextView right = new TextView(this);
        right.setText(value);
        right.setTextColor(ACCENT);
        right.setTextSize(14);
        right.setTypeface(null, Typeface.BOLD);
        right.setGravity(Gravity.END);

        row.addView(left, new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.WRAP_CONTENT, 1));
        row.addView(right);

        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                -1, -2);
        params.bottomMargin = 5;
        root.addView(row, params);
    }

    private void addProfile(String title, String detail) {
        TextView card = new TextView(this);
        card.setText(title + "\n" + detail);
        card.setTextColor(WHITE);
        card.setTextSize(15);
        card.setPadding(18, 16, 18, 16);
        card.setBackgroundColor(PANEL);

        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, -2);
        params.bottomMargin = 8;
        root.addView(card, params);
    }

    private void addButton(String text, Runnable action) {
        Button button = new Button(this);
        button.setText(text);
        button.setTextColor(WHITE);
        button.setBackgroundTintList(
                android.content.res.ColorStateList.valueOf(ACCENT));
        button.setOnClickListener(v -> action.run());

        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, -2);
        params.bottomMargin = 10;
        root.addView(button, params);
    }

    private void addSpace() {
